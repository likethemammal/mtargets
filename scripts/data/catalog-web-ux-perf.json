{
  "catalogId": "catalog-web-ux-perf",
  "title": "Web & UX performance (1–40)",
  "tags": [
    "web",
    "ux",
    "lighthouse",
    "rum"
  ],
  "intent": "Full examples for Core Web Vitals, lab diagnostics, resource budgets, navigation timing, jank, animation, and memory.",
